        }
      ],
      "returns": "geometry",
      "dialects": {
        "postgres": "ST_SetSRID({geom}, {srid})",
        "mssql": "{geom}.STSrid = {srid}",
        "mysql": "ST_SRID({geom}, {srid})",
        "oracle": "SDO_CS.TRANSFORM({geom}, {srid})",
        "sqlite": "SetSRID({geom}, {srid})"
