        "mssql": "{geom}.MakeValid()",
        "mysql": "ST_MakeValid({geom})",
        "oracle": "SDO_UTIL.RECTIFY_GEOMETRY({geom}, 0.005)",
        "sqlite": "MakeValid({geom})"
      }
    },
    "ST_Simplify": {
      "description": "Semplifica geometria con tolleranza",
      "category": "spatial",
      "params": [
        {
          "name": "geom",
          "type": "geometry",
          "required": true
        },
        {
          "name": "tolerance",
          "type": "number",
          "required": true
        }
      ],
      "returns": "geometry",
      "dialects": {
        "postgres": "ST_Simplify({geom}, {tolerance})",
        "mssql": "{geom}.Reduce({tolerance})",
        "mysql": "ST_Simplify({geom}, {tolerance})",
        "oracle": "SDO_UTIL.SIMPLIFY({geom}, {tolerance})",
        "sqlite": "Simplify({geom}, {tolerance})"
      }
    },
