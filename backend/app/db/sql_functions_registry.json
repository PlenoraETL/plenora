        }
      ],
      "returns": "number",
      "dialects": {
        "postgres": "ST_X({geom})",
        "mssql": "{geom}.STX",
        "mysql": "ST_X({geom})",
        "oracle": "SDO_GEOM.SDO_POINTONSURFACE({geom}, 0.005).SDO_POINT.X",
        "sqlite": "X({geom})"
      }
    },
    "ST_Y": {
