        "mssql": "{geom}.STConvexHull()",
        "mysql": "ST_ConvexHull({geom})",
        "oracle": "SDO_GEOM.SDO_CONVEXHULL({geom}, 0.005)",
        "sqlite": "ConvexHull({geom})"
      }
    },
    "ST_Envelope": {
