        "mssql": "{geom}.STLength()",
        "mysql": "ST_Length({geom})",
        "oracle": "SDO_GEOM.SDO_LENGTH({geom}, 0.005)",
        "sqlite": "GLength({geom})"
      }
    },
    "ST_Centroid": {
      "description": "Calcola centroide di una geometria",
