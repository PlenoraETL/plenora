    "ST_Intersection": {
      "description": "Intersezione di due geometrie",
      "category": "spatial",
      "params": [
        {
          "name": "geom1",
          "type": "geometry",
          "required": true
        },
        {
          "name": "geom2",
          "type": "geometry",
          "required": true
        }
