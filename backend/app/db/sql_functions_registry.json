      ],
      "returns": "boolean",
      "dialects": {
        "postgres": "ST_IsValid({geom})",
        "mssql": "{geom}.STIsValid() = 1",
        "mysql": "ST_IsValid({geom})",
        "oracle": "SDO_GEOM.VALIDATE_GEOMETRY_WITH_CONTEXT({geom}, 0.005) = 'TRUE'",
        "sqlite": "IsValid({geom})"
      }
