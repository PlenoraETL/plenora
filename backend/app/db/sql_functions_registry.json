{
  "_meta": {
    "version": "1.0.0",
    "description": "Registry funzioni SQL multi-database per PLENORA-ETL",
    "supported_databases": [
      "postgres",
      "mssql",
      "mysql",
      "oracle",
      "sqlite"
    ]
  },
  "spatial": {
    "ST_Buffer": {
      "description": "Crea buffer attorno a geometria",
      "category": "spatial",
      "params": [
        {
          "name": "geom",
          "type": "geometry",
          "required": true
        },
        {
          "name": "distance",
          "type": "number",
          "required": true
        },
        {
          "name": "segments",
          "type": "integer",
          "required": false,
          "default": 8
        }
      ],
      "returns": "geometry",
      "dialects": {
        "postgres": "ST_Buffer({geom}, {distance})",
        "mssql": "{geom}.STBuffer({distance})",
        "mysql": "ST_Buffer({geom}, {distance})",
        "oracle": "SDO_GEOM.SDO_BUFFER({geom}, {distance}, 0.005)",
        "sqlite": "Buffer({geom}, {distance})"
      }
    },
    "ST_Intersects": {
      "description": "Verifica se due geometrie si intersecano",
      "category": "spatial",
      "params": [
        {
          "name": "geom1",
          "type": "geometry",
          "required": true
        },
        {
          "name": "geom2",
          "type": "geometry",
          "required": true
        }
      ],
      "returns": "boolean",
      "dialects": {
        "postgres": "ST_Intersects({geom1}, {geom2})",
        "mssql": "{geom1}.STIntersects({geom2}) = 1",
        "mysql": "ST_Intersects({geom1}, {geom2})",
        "oracle": "SDO_RELATE({geom1}, {geom2}, 'mask=ANYINTERACT') = 'TRUE'",
        "sqlite": "Intersects({geom1}, {geom2})"
      }
    },
    "ST_Contains": {
      "description": "Verifica se geom1 contiene geom2",
      "category": "spatial",
      "params": [
        {
          "name": "geom1",
          "type": "geometry",
          "required": true
        },
        {
          "name": "geom2",
          "type": "geometry",
          "required": true
        }
      ],
      "returns": "boolean",
      "dialects": {
        "postgres": "ST_Contains({geom1}, {geom2})",
        "mssql": "{geom1}.STContains({geom2}) = 1",
        "mysql": "ST_Contains({geom1}, {geom2})",
        "oracle": "SDO_RELATE({geom1}, {geom2}, 'mask=CONTAINS') = 'TRUE'",
        "sqlite": "Contains({geom1}, {geom2})"
      }
    },
    "ST_Within": {
      "description": "Verifica se geom1 \u00e8 contenuta in geom2",
      "category": "spatial",
      "params": [
        {
          "name": "geom1",
          "type": "geometry",
          "required": true
        },
        {
          "name": "geom2",
          "type": "geometry",
          "required": true
        }
      ],
      "returns": "boolean",
      "dialects": {
        "postgres": "ST_Within({geom1}, {geom2})",
        "mssql": "{geom1}.STWithin({geom2}) = 1",
        "mysql": "ST_Within({geom1}, {geom2})",
        "oracle": "SDO_RELATE({geom1}, {geom2}, 'mask=INSIDE') = 'TRUE'",
        "sqlite": "Within({geom1}, {geom2})"
      }
    },
    "ST_DWithin": {
      "description": "Verifica se due geometrie sono entro una distanza",
      "category": "spatial",
      "params": [
        {
          "name": "geom1",
          "type": "geometry",
          "required": true
        },
        {
          "name": "geom2",
          "type": "geometry",
          "required": true
        },
        {
          "name": "distance",
          "type": "number",
          "required": true
        }
      ],
      "returns": "boolean",
      "dialects": {
        "postgres": "ST_DWithin({geom1}, {geom2}, {distance})",
        "mssql": "{geom1}.STDistance({geom2}) <= {distance}",
        "mysql": "ST_Distance({geom1}, {geom2}) <= {distance}",
        "oracle": "SDO_WITHIN_DISTANCE({geom1}, {geom2}, 'distance={distance}') = 'TRUE'",
        "sqlite": "Distance({geom1}, {geom2}) <= {distance}"
      }
    },
    "ST_Distance": {
      "description": "Calcola distanza tra due geometrie",
      "category": "spatial",
      "params": [
        {
          "name": "geom1",
          "type": "geometry",
          "required": true
        },
        {
          "name": "geom2",
          "type": "geometry",
          "required": true
        }
      ],
      "returns": "number",
      "dialects": {
        "postgres": "ST_Distance({geom1}, {geom2})",
        "mssql": "{geom1}.STDistance({geom2})",
        "mysql": "ST_Distance({geom1}, {geom2})",
        "oracle": "SDO_GEOM.SDO_DISTANCE({geom1}, {geom2}, 0.005)",
        "sqlite": "Distance({geom1}, {geom2})"
      }
    },
    "ST_Area": {
