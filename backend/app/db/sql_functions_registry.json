      ],
      "returns": "number",
      "dialects": {
        "postgres": "ST_Area({geom})",
        "mssql": "{geom}.STArea()",
        "mysql": "ST_Area({geom})",
        "oracle": "SDO_GEOM.SDO_AREA({geom}, 0.005)",
        "sqlite": "Area({geom})"
      }
    },
    "ST_Length": {
      "description": "Calcola lunghezza di una linea",
