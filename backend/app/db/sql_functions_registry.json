      ],
      "returns": "geometry",
      "dialects": {
        "postgres": "ST_GeomFromText({wkt}, {srid})",
        "mssql": "geometry::STGeomFromText({wkt}, {srid})",
        "mysql": "ST_GeomFromText({wkt}, {srid})",
        "oracle": "SDO_GEOMETRY({wkt}, {srid})",
        "sqlite": "GeomFromText({wkt}, {srid})"
      }
    },
    "ST_MakePoint": {
      "description": "Crea punto da coordinate",
      "category": "spatial",
      "params": [
        {
          "name": "x",
          "type": "number",
          "required": true
        },
        {
          "name": "y",
          "type": "number",
          "required": true
        },
        {
          "name": "srid",
          "type": "integer",
          "required": false,
          "default": 4326
        }
      ],
      "returns": "geometry",
      "dialects": {
        "postgres": "ST_SetSRID(ST_MakePoint({x}, {y}), {srid})",
        "mssql": "geometry::Point({x}, {y}, {srid})",
        "mysql": "ST_SRID(POINT({x}, {y}), {srid})",
        "oracle": "SDO_GEOMETRY(2001, {srid}, SDO_POINT_TYPE({x}, {y}, NULL), NULL, NULL)",
        "sqlite": "MakePoint({x}, {y}, {srid})"
      }
    },
    "ST_X": {
      "description": "Estrae coordinata X da punto",
