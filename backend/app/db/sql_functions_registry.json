      "params": [
        {
          "name": "geom",
          "type": "geometry",
          "required": true
        }
      ],
      "returns": "geometry",
      "dialects": {
        "postgres": "ST_Envelope({geom})",
        "mssql": "{geom}.STEnvelope()",
        "mysql": "ST_Envelope({geom})",
        "oracle": "SDO_GEOM.SDO_MBR({geom})",
        "sqlite": "Envelope({geom})"
      }
    },
    "ST_Touches": {
      "description": "Returns true if the geometries have at least one point in common but their interiors do not intersect",
      "params": [
        {
          "name": "geom1",
          "type": "geometry",
          "required": true
        },
        {
          "name": "geom2",
          "type": "geometry",
          "required": true
        }
      ],
      "returns": "boolean",
      "dialects": {
        "postgres": "ST_Touches({geom1}, {geom2})",
        "mssql": "{geom1}.STTouches({geom2}) = 1",
        "mysql": "ST_Touches({geom1}, {geom2})",
        "oracle": "SDO_RELATE({geom1}, {geom2}, 'mask=TOUCH') = 'TRUE'",
        "sqlite": "Touches({geom1}, {geom2})"
      }
    },
    "ST_Overlaps": {
      "description": "Returns true if the geometries share space but are not completely contained by each other",
      "params": [
        {
          "name": "geom1",
          "type": "geometry",
          "required": true
        },
        {
          "name": "geom2",
          "type": "geometry",
          "required": true
        }
      ],
      "returns": "boolean",
      "dialects": {
        "postgres": "ST_Overlaps({geom1}, {geom2})",
        "mssql": "{geom1}.STOverlaps({geom2}) = 1",
        "mysql": "ST_Overlaps({geom1}, {geom2})",
        "oracle": "SDO_RELATE({geom1}, {geom2}, 'mask=OVERLAPBDYINTERSECT+OVERLAPBDYDISJOINT') = 'TRUE'",
        "sqlite": "Overlaps({geom1}, {geom2})"
      }
    }
  },
