        "limitations": [
          "Temperatura in Kelvin (sottrarre 273.15 per °C)",
          "Pressione in Pa",
          "Vento in m/s",
          "Prodotti: B12101=Temp, B13011=Precip, B13003=Umidità, B11002=Vento, B10004=Pressione"
        ]
      },
      "config": {
        "api_type": "generator",
        "endpoint": {
          "url": "https://meteohub.agenziaitaliameteo.it/api/observations",
          "method": "GET"
        },
        "auth": {
          "type": "none"
        },
        "static_parameters": {
          "reliabilityCheck": "true",
          "last": "true"
        },
        "options": {
          "rate_limit": 1,
          "timeout": 120,
          "retry_count": 2
        }
      },
      "parameters": [
        {
          "name": "q",
          "type": "string",
          "required": true,
          "description": "Query (modifica date e product)",
          "default": "reftime: >={{NOW-2h}},<={{NOW}};product:B12101;license:CCBY_COMPLIANT;timerange:254,0,0;level:103,2000,0,0",
          "example": "reftime: >={{NOW-2h}},<={{NOW}};product:B12101;license:CCBY_COMPLIANT;timerange:254,0,0;level:103,2000,0,0"
        }
      ],
      "output_mapping": [
        {
          "path": "data[].stat.lat",
          "column": "lat",
          "description": "Latitudine stazione"
        },
        {
          "path": "data[].stat.lon",
          "column": "lon",
          "description": "Longitudine stazione"
        },
        {
          "path": "data[].stat.net",
          "column": "rete",
          "description": "Rete di appartenenza"
        },
