# Plenora E2E — credenziali test (NON usare in prod)
# Copia in `.env` per usare con docker compose.

# ── Postgres (PostGIS) ────────────────────────────────────────────
POSTGRES_USER=plenora
POSTGRES_PASSWORD=plenora_test_pwd
POSTGRES_DB=plenora_test

# ── MySQL ─────────────────────────────────────────────────────────
MYSQL_ROOT_PASSWORD=plenora_test_root
MYSQL_DATABASE=plenora_test
MYSQL_USER=plenora
MYSQL_PASSWORD=plenora_test_pwd

# ── SQL Server ────────────────────────────────────────────────────
MSSQL_SA_PASSWORD=PlenoraTest!2026
MSSQL_DATABASE=plenora_test

# ── Oracle ────────────────────────────────────────────────────────
ORACLE_PASSWORD=plenora_test_pwd
ORACLE_DATABASE=plenora_test

# ── MinIO (S3) ────────────────────────────────────────────────────
MINIO_ROOT_USER=plenora_minio
MINIO_ROOT_PASSWORD=plenora_minio_pwd
MINIO_DEFAULT_BUCKETS=plenora-test,plenora-artifacts

# ── Azurite (Azure Blob) ──────────────────────────────────────────
# Connection string default: DefaultEndpointsProtocol=http;AccountName=devstoreaccount1;
# AccountKey=Eby8vdM02xNOcqFlqUwJPLlmEtlCDXJ1OUzFT50uSRZ6IFsuFq2UVErCz4I6tq/K1SZFPTOtr/KBHBeksoGMGw==;
# (default Azurite — non modificare per compatibilità con SDK)

# ── FTP ───────────────────────────────────────────────────────────
FTP_USER_NAME=tester
FTP_USER_PASS=plenora_ftp_pwd
FTP_USER_HOME=/home/tester

# ── SFTP ──────────────────────────────────────────────────────────
SFTP_USER=tester
SFTP_PASS=plenora_sftp_pwd
SFTP_PRIVATE_KEY_PATH=test-e2e/docker/sftp/keys/id_rsa_test
SFTP_PRIVATE_KEY_PASSPHRASE_PATH=test-e2e/docker/sftp/keys/id_rsa_test_passphrase
SFTP_PRIVATE_KEY_PASSPHRASE=plenora_passphrase_test

# ── LocalStack (AWS SSM/S3 fake) ──────────────────────────────────
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_DEFAULT_REGION=us-east-1
AWS_ENDPOINT_URL=http://plenora-e2e-localstack:4566
SSM_PARAMETER_PREFIX=/plenora/test/
BACKUP_BUCKET=plenora-backups
LOG_ARCHIVE_BUCKET=plenora-log-archive

# ── Redis ─────────────────────────────────────────────────────────
# Nessuna password — bind solo su rete interna del compose.
