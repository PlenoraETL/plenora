{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadSecretsFromSSM",
      "Effect": "Allow",
      "Action": [
        "ssm:GetParametersByPath",
        "ssm:GetParameter",
        "ssm:GetParameters"
      ],
      "Resource": [
        "arn:aws:ssm:eu-south-1:112011134642:parameter/plenora/prod",
        "arn:aws:ssm:eu-south-1:112011134642:parameter/plenora/prod/*"
      ]
    },
    {
      "Sid": "DecryptSecureStringParams",
      "Effect": "Allow",
      "Action": "kms:Decrypt",
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "kms:ViaService": "ssm.eu-south-1.amazonaws.com"
        }
      }
    }
  ]
}
