[Unit]
Description=PLENORA-ETL Worker (Dramatiq)
After=network.target rabbitmq-server.service postgresql.service

[Service]
User=ubuntu
WorkingDirectory=/home/ubuntu/plenora-etl/backend
# Plenora 2.0: il worker esegue gli actor Dramatiq da RabbitMQ (Redis
# rimosso: stato/lock/blacklist/rate-limit sono su PostgreSQL). Il nome
# dell'unit resta plenora-celery per compat dei runbook/migrazioni.
ExecStart=/home/ubuntu/plenora-etl/backend/venv/bin/dramatiq workers.dramatiq_app --processes 2 --threads 4
Restart=always
RestartSec=5
EnvironmentFile=/home/ubuntu/plenora-etl/backend/.env

[Install]
WantedBy=multi-user.target
