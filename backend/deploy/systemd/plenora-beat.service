[Unit]
Description=PLENORA-ETL Beat (APScheduler)
After=network.target rabbitmq-server.service postgresql.service

[Service]
User=ubuntu
WorkingDirectory=/home/ubuntu/plenora-etl/backend
# Plenora 2.0 Fase 3: il beat gira su APScheduler (workers.beat), non piu' su
# celery beat. Leader-lock e schedule su PostgreSQL.
ExecStart=/home/ubuntu/plenora-etl/backend/venv/bin/python -m workers.beat
Restart=always
RestartSec=5
EnvironmentFile=/home/ubuntu/plenora-etl/backend/.env

[Install]
WantedBy=multi-user.target
