[Unit]
Description=PLENORA-ETL Celery Beat
After=network.target redis.service

[Service]
User=ubuntu
WorkingDirectory=/home/ubuntu/plenora-etl/backend
ExecStart=/home/ubuntu/plenora-etl/backend/venv/bin/celery -A workers.celery_app beat -S workers.beat_scheduler.PlenoraBeatScheduler --loglevel=info
Restart=always
RestartSec=5
EnvironmentFile=/home/ubuntu/plenora-etl/backend/.env

[Install]
WantedBy=multi-user.target
