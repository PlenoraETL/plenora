# Plenora test2 lane — estende l'immagine backend con le dipendenze dev/test.
#
# Prerequisito: l'immagine `plenora-backend:scaffold` deve esistere
# (`docker compose build backend`). Il codice NON viene ricopiato: a runtime
# docker-compose.test2.yml monta ./backend su /app, quindi i test girano sul
# working tree corrente senza rebuild. Rebuild necessaria solo quando cambiano
# requirements.lock o requirements-dev.lock.
#
# Motivazione: suite riproducibile con lo stack pinnato del container
# (python conda-forge + gdal/pyogrio identici al runtime), indipendente dal
# python rolling dell'host (CachyOS). NB: i container condividono il kernel
# dell'host — questa lane isola dalle *librerie* host, non da bug kernel.

FROM plenora-backend:scaffold

USER root

COPY backend/requirements-dev.lock /tmp/requirements-dev.lock

RUN pip install --require-hashes -r /tmp/requirements-dev.lock \
    && rm /tmp/requirements-dev.lock

# L'utente effettivo viene impostato da docker-compose.test2.yml (uid host)
# perche' /app e' un bind mount e .pytest-run deve restare scrivibile/rimovibile
# dall'utente host.

WORKDIR /app

ENTRYPOINT ["python", "-m", "pytest"]
CMD ["tests2", "-q"]
