# Copy this file to `.env` in the same directory.
# `.env` is ignored by git through the repository root .gitignore.

# Option A: use a ready JWT token.
# PLENORA_E2E_TOKEN=

# Option B: let tests login through /api/auth/login.
PLENORA_E2E_USERNAME=
PLENORA_E2E_PASSWORD=

# Defaults usually work for local Docker install.
PLENORA_E2E_API_BASE_URL=http://127.0.0.1:5004/api
PLENORA_E2E_DB_CONTAINER=plenora-postgres-1
PLENORA_E2E_DB_USER=plenora
PLENORA_E2E_DB_NAME=plenora

# Set to 1 to inspect generated projects after successful tests.
PLENORA_E2E_KEEP_ON_SUCCESS=0
