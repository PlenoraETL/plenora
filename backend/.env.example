# =============================================================================
# URBY-ETL — Configurazione di installazione
# =============================================================================
# Copia questo file in .env e compila i valori obbligatori prima di avviare.
#
# Questi parametri configurano l'INFRASTRUTTURA del sistema (dove gira Redis,
# dove salvare i dati, ecc.). Non cambiarli a runtime.
#
# La configurazione APPLICATIVA (timeout, batch size, worker paralleli, ecc.)
# è gestita da data/config.json, creato automaticamente al primo avvio.
# =============================================================================


# -----------------------------------------------------------------------------
# DIRECTORY DATI  [OBBLIGATORIO in produzione]
# -----------------------------------------------------------------------------
# Usa un path ASSOLUTO in produzione. Il default relativo ./data funziona
# solo se avvii sempre l'app dalla stessa working directory.
#
# DATA_DIR=/opt/urby-etl/data


# -----------------------------------------------------------------------------
# CHIAVE DI CIFRATURA  [OBBLIGATORIO in produzione]
# -----------------------------------------------------------------------------
# Chiave usata per cifrare at-rest tutti i campi sensibili nel DB:
#   - password DB connections
#   - auth.{password,token,client_secret,access_token,key_value} delle API
#   - password/private_key/client_secret dei datasources (FTP/SFTP/SharePoint)
#
# In produzione (ENVIRONMENT=production) l'app si rifiuta di partire se questa
# variabile manca. In sviluppo viene usata una chiave di default con WARNING.
#
# IMPORTANTE: una volta cifrati i dati, NON cambiare questa chiave.
# Cambiarla rende illeggibili tutti i record cifrati esistenti.
#
# Per generare una chiave robusta:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
#
# PLENORA_ENCRYPTION_KEY=
# Nome legacy ancora accettato (retro-compat): URBY_ENCRYPTION_KEY=


# -----------------------------------------------------------------------------
# AMBIENTE  [OBBLIGATORIO in produzione]
# -----------------------------------------------------------------------------
# Imposta a "production" prima del deploy. Attiva i fail-fast (es. PLENORA_ENCRYPTION_KEY
# obbligatoria, JWT secret obbligatorio, ecc.).
#
# ENVIRONMENT=production


# -----------------------------------------------------------------------------
# JWT  [OBBLIGATORIO in produzione]
# -----------------------------------------------------------------------------
# Chiave usata per firmare i token JWT di autenticazione. In produzione
# (ENVIRONMENT=production o staging) l'app si rifiuta di partire se manca.
# In sviluppo viene generato un secret random per sessione: i token diventano
# invalidi ad ogni riavvio (è scomodo ma sicuro), valorizzala anche in dev
# se vuoi che i login persistano fra restart.
#
# IMPORTANTE: ruotare questa chiave invalida tutti i token attivi → tutti gli
# utenti dovranno rifare login. Pianifica le rotazioni di conseguenza.
#
# Per generare una chiave robusta:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
#
# JWT_SECRET_KEY=
#
# Durata dei token in ore (default 8). Più corto = più sicuro ma più scomodo.
# JWT_EXPIRE_HOURS=8


# -----------------------------------------------------------------------------
# DATABASE POSTGRESQL  [OBBLIGATORIO]
# -----------------------------------------------------------------------------
# Connection string PostgreSQL. L'app si rifiuta di partire se manca.
#
# DATABASE_URL=postgresql://user:password@host:5432/dbname
# DB_SCHEMA=plenora
#
# ---- Pool sizing (OPZIONALE, default sensati per deployment tipico) ----
# ATTENZIONE: il pool psycopg2 e' SINGLETON PER-PROCESSO. Ogni uvicorn
# worker, ogni celery prefork child e il celery beat ne creano uno
# separato. Il consumo PG aggregato al picco e':
#     N_processi × DB_POOL_MAX
# dove N_processi = uvicorn_workers + celery_concurrency + 1 (beat).
# Verifica che il totale resti sotto `max_connections` di Postgres
# (con reserve di ~5 per superuser / autovacuum / ad-hoc).
#
# Esempio: 2 uvicorn worker + 4 celery concurrency + beat = 7 processi
#          → con DB_POOL_MAX=12, worst-case 84 conn su PG max=100. OK.
#
# DB_POOL_MIN=2         # connessioni sempre pronte (default 2)
# DB_POOL_MAX=12        # tetto per-processo (default 12)
#
# ---- idle-in-transaction timeout (OPZIONALE, raccomandato) ----
# Millisecondi di inattivita' dentro BEGIN dopo i quali Postgres chiude
# la connessione. Protegge contro zombie da transazioni applicative
# leaked (codice che non committa/rollbacka). Applicato via GUC
# per-connessione: non tocca postgresql.conf, scope solo ai nostri pool.
# Default 300000 (5 min). Imposta 0 per disabilitare.
#
# DB_IDLE_IN_TRANSACTION_TIMEOUT_MS=300000
#
# ---- Topology hints per log aggregato (OPZIONALE) ----
# Se settate, il log all'init del pool stampa la stima corretta del
# consumo PG aggregato (altrimenti assume 1 uvicorn + 0 celery).
# Devono riflettere cio' che gli ExecStart systemd passano come flag
# (--workers, --concurrency), NON limitano nulla runtime.
#
# UVICORN_WORKERS=2     # deve coincidere con --workers in urby-backend.service
# CELERY_CONCURRENCY=4  # deve coincidere con --concurrency in urby-celery.service


# -----------------------------------------------------------------------------
# REDIS / CELERY  [OBBLIGATORIO]
# -----------------------------------------------------------------------------
# Redis è richiesto per i task asincroni (arricchimento, caricamento DB).
# Senza Redis i task Celery non funzionano — l'app lo segnala all'avvio.
#
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0


# -----------------------------------------------------------------------------
# FILE DI CONFIGURAZIONE  [OPZIONALE]
# -----------------------------------------------------------------------------
# Path del file JSON di configurazione runtime. Utile per ambienti multipli
# (dev/staging/prod) senza modificare il codice.
# Default: ./data/config.json
#
# URBY_CONFIG_FILE=/opt/urby-etl/data/config.json
