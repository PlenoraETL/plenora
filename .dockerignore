# BE-GO-READY-INSTALL-011-FIRST-DOCKER-SCAFFOLD
#
# Reduce build context. The Dockerfile copies `backend/` plus the
# requirements file; everything else is dead weight that slows the
# build and (worse) can leak local secrets into image layers.

# Git
.git/
.gitignore
.gitattributes

# Local env / secrets - NEVER copy these into an image
.env
.env.local
.env.production
.env.docker
backend/.env
backend/.env.local
backend/.env.production
**/secrets.json
**/credentials.json

# Python venvs / caches
.venv/
venv/
**/venv/
**/.venv/
**/__pycache__/
**/*.pyc
**/*.pyo
**/.pytest_cache/
**/.mypy_cache/
**/.ruff_cache/
**/htmlcov/
**/.coverage
**/.coverage.*
**/.hypothesis/

# Editor / IDE
.idea/
.vscode/
.cursorignore
.cursorindexingignore

# Claude / agent state
.claude/
.agent-temp/

# Node / frontend build artifacts
node_modules/
**/node_modules/
frontend/node_modules/
frontend/dist/
frontend/.vite/

# Backend pytest temp dirs (left behind by tests on Windows)
backend/.pytest-basetemp*/
backend/.pytest-run-*/
backend/.pytest-b*/
backend/.pytest-local*/
backend/.agent-pytest-tmproot/
backend/pytesttmp-*/
pytesttmp-*/

# Local DB / data
data/
backend/data/
*.db
*.db-wal
*.db-shm
backups/

# Logs / archives
*.log
*.zip

# Documentation context (not needed at runtime)
docs/
*.md

# OS
.DS_Store
Thumbs.db

# Docker artifacts themselves (no recursive include)
Dockerfile
docker-compose*.yml
.dockerignore
