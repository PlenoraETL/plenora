# BE-GO-READY-INSTALL-011-FIRST-DOCKER-SCAFFOLD
#
# Copy this file to `.env.docker` BEFORE the first `docker compose
# up`. Fill in PLENORA_ENCRYPTION_KEY and JWT_SECRET_KEY (generate
# with the python one-liners below). The compose file mounts this
# via env_file: .env.docker.
#
# `.env.docker` is gitignored AND dockerignored. The example file
# (this one) is committed.

# ---------------------------------------------------------------------------
# Required: deployment policy
# ---------------------------------------------------------------------------
ENVIRONMENT=development
DB_SCHEMA=plenora
STORAGE_POLICY=db
OBJECT_STORAGE_ENABLED=false
BACKUP_BUCKET=plenora-docker-no-real-s3

# ---------------------------------------------------------------------------
# Required: secrets - GENERATE BEFORE FIRST RUN
# ---------------------------------------------------------------------------
# Generate via:
#   python -c "import secrets; print('PLENORA_ENCRYPTION_KEY=' + secrets.token_urlsafe(48))"
#   python -c "import secrets; print('JWT_SECRET_KEY=' + secrets.token_urlsafe(48))"
PLENORA_ENCRYPTION_KEY=
JWT_SECRET_KEY=

# Variabili compilate nel bundle frontend (mai inserire segreti VITE_*).
FRONTEND_VITE_API_URL=http://localhost:5004
# FRONTEND_VITE_SENTRY_DSN=
# FRONTEND_VITE_SENTRY_TRACES_SAMPLE_RATE=0.1

# Pool PostgreSQL per ogni processo backend/worker/beat (override opzionali).
# DB_POOL_MIN=2
# DB_POOL_MAX=12
# DB_POOL_TIMEOUT_SECONDS=30
# DB_IDLE_IN_TRANSACTION_TIMEOUT_MS=300000

# ---------------------------------------------------------------------------
# Memory caps (override here if container memory differs from default)
# ---------------------------------------------------------------------------
# Defaults from Settings.DEFAULTS in backend/app/config.py. Cap <= 0
# disables the corresponding guard. See
# docs/ops/install-non-docker.md section 6.2 for the small-PC tier.
# LOAD_FILE_MAX_BYTES=209715200       # 200 MB upload cap
# WORKER_RSS_MAX_BYTES=1500000000     # 1.5 GB worker RSS
# WORKER_MEMORY_CLEANUP_ENABLED=true
# WORKER_MEMORY_MALLOC_TRIM_ENABLED=true
# WORKER_MEMORY_RECYCLE_ENABLED=true
# WORKER_MEMORY_RECYCLE_RSS_BYTES=1500000000
# Isolamento sperimentale pipeline.execute in processo usa-e-getta.
# Funziona allo stesso modo su Linux e Docker Desktop Windows.
# DATA_PLANE_EXECUTION_MODE=inline
# DATA_PLANE_CHILD_TIMEOUT_SECONDS=3900
# RESOURCE_MAX_BYTES=209715200        # 200 MB single-blob read cap
# ARTIFACT_PREVIEW_MAX_BYTES=26214400 # 25 MB intermediate preview cap
# CROSS_JOIN_MAX_OUTPUT_ROWS=50000000
# MULTI_JOIN_MAX_OUTPUT_ROWS=50000000

# ---------------------------------------------------------------------------
# DATABASE_URL / DRAMATIQ_BROKER_URL / DATA_DIR are set in
# docker-compose.yml `environment:` (service-name DNS resolution:
# postgres:5432, rabbitmq:5672). Do NOT override unless you moved the
# dependencies outside the compose network.
# ---------------------------------------------------------------------------
