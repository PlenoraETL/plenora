# ─── URBY-ETL Frontend — Variabili d'ambiente ────────────────────────────────
#
# Copia questo file in:
#   .env.local          per sviluppo locale (non committare)
#   .env.production     per build di produzione (committare senza segreti)
#
# Solo le variabili con prefisso VITE_ sono esposte al browser.
# Le variabili senza prefisso sono disponibili solo in vite.config.js.
#
# ─────────────────────────────────────────────────────────────────────────────

# URL base del backend FastAPI
# Dev:  http://localhost:8000
# Prod: https://urby-etl.icsc.it  (o IP del server)
VITE_API_URL=http://localhost:8000

# Ambiente (usato per logging e feature flags)
# Valori: development | staging | production
VITE_ENV=development

# Versione applicazione (opzionale, mostrata in footer/about)
VITE_APP_VERSION=1.0.0
