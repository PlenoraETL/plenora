# ─── PLENORA-ETL Frontend — Variabili d'ambiente ────────────────────────────
#
# Copia questo file in:
#   .env.local              sviluppo locale, non committare (gitignored)
#   .env.production.local   override locale per build prod, non committare (gitignored)
#
# In produzione lasciare VITE_API_URL vuota usa /api same-origin. Non inserire
# mai credenziali o segreti in nessuno dei file .env del frontend.
#
# Solo le variabili con prefisso VITE_ sono esposte al browser.
# Le variabili senza prefisso sono disponibili solo in vite.config.js.
#
# ────────────────────────────────────────────────────────────────────────────

# URL base del backend FastAPI
# Dev: usare `.env.development` (http://localhost:5004)
# Prod single-server: vuoto (same-origin /api)
VITE_API_URL=

# Telemetria browser opzionale. Il DSN e' pubblico per natura, ma non inserire
# token di autenticazione o altre credenziali nelle variabili VITE_*.
# VITE_SENTRY_DSN=
# VITE_SENTRY_TRACES_SAMPLE_RATE=0.1

# Solo sviluppo locale: runtimeEnv forza comunque false nelle build prod.
# VITE_USE_MOCKS=false
